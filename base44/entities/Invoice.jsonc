{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Related ClientProject ID"
    },
    "invoice_number": {
      "type": "string",
      "description": "Invoice number"
    },
    "client_email": {
      "type": "string",
      "description": "Client email"
    },
    "amount": {
      "type": "number",
      "description": "Invoice amount"
    },
    "currency": {
      "type": "string",
      "default": "USD",
      "description": "Currency code"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue",
        "cancelled"
      ],
      "default": "draft",
      "description": "Invoice status"
    },
    "issue_date": {
      "type": "string",
      "format": "date",
      "description": "Issue date"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Due date"
    },
    "paid_date": {
      "type": "string",
      "format": "date",
      "description": "Payment date"
    },
    "description": {
      "type": "string",
      "description": "Invoice description"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "rate": {
            "type": "number"
          },
          "amount": {
            "type": "number"
          }
        }
      },
      "description": "Line items"
    }
  },
  "required": [
    "project_id",
    "invoice_number",
    "client_email",
    "amount"
  ]
}