{
  "name": "ProjectMessage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Related ClientProject ID"
    },
    "sender_email": {
      "type": "string",
      "description": "Sender email"
    },
    "sender_name": {
      "type": "string",
      "description": "Sender name"
    },
    "message": {
      "type": "string",
      "description": "Message content"
    },
    "is_admin": {
      "type": "boolean",
      "default": false,
      "description": "Is message from admin/studio"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Has been read"
    }
  },
  "required": [
    "project_id",
    "sender_email",
    "message"
  ]
}