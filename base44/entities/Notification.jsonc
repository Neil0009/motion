{
  "name": "Notification",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Recipient email"
    },
    "project_id": {
      "type": "string",
      "description": "Related project ID"
    },
    "type": {
      "type": "string",
      "enum": [
        "message",
        "milestone",
        "file",
        "invoice"
      ],
      "description": "Notification type"
    },
    "title": {
      "type": "string",
      "description": "Notification title"
    },
    "message": {
      "type": "string",
      "description": "Notification message"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Has been read"
    },
    "action_url": {
      "type": "string",
      "description": "URL to navigate to"
    }
  },
  "required": [
    "user_email",
    "type",
    "title",
    "message"
  ]
}